[run]
source = app
branch = True
omit =
    app/main.py
    app/core/config.py
    app/db/migrations/*
    tests/*
    */__init__.py

[report]
show_missing = True
precision = 2
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if TYPE_CHECKING:
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:

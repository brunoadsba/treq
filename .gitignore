# ============================================
# Treq Enterprise - .gitignore
# Padrão de Indústria para Projetos Python + Next.js
# ============================================

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
ENV/
env/
treq-venv/

# ============================================
# Node.js / Next.js
# ============================================
node_modules/
.next/
out/
.swc/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# Environment Variables (NUNCA versionar)
# ============================================
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# ============================================
# IDEs e Editores
# ============================================
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# ============================================
# Sistema Operacional
# ============================================
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# ============================================
# Logs e Temporários
# ============================================
*.log
logs/
*.tmp
*.temp
*.bak
*.backup
*~

# ============================================
# Build e Cache
# ============================================
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.tsbuildinfo
coverage/

# ============================================
# Dados e Modelos (NÃO versionar)
# ============================================
*.bin
*.onnx
*.pkl
*.h5
models/
data/
*.db
*.sqlite
*.sqlite3

# ============================================
# Segurança (NUNCA versionar)
# ============================================
*.pem
*.key
*.crt
*.cert
secrets/
credentials/

# ============================================
# Diretórios do Projeto (específicos)
# ============================================

# Arquivos obsoletos/históricos
obsolete/

# Documentação de execução (local)
execucao/

# Scripts de desenvolvimento (já em backend/scripts)
scripts/

# Backups locais
backups/

# ============================================
# Arquivos a VERSIONAR (exceções explícitas)
# ============================================
# README principal e dos subprojetos
!README.md
!backend/README.md
!frontend/README.md

# Arquivos de deploy (render.yaml, etc)
!render.yaml
!render-blueprint.yaml
!runtime.txt

# Configuração de exemplo
!backend/.env.example

# Documentação essencial
!DEPLOY.md
!DEPLOY_AUTO.md
!MONITORING.md

# Planejamento estratégico
!Planejamento-Estrategico/
OpenWork/

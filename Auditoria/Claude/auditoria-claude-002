# backend/app/core/validators.py
from pydantic import BaseModel, validator, Field
from typing import Optional
import re

class ChatMessageValidator(BaseModel):
    message: str = Field(..., min_length=1, max_length=10000)
    user_id: str = Field(..., regex=r'^[a-f0-9-]{36}$')  # UUID format
    
    @validator('message')
    def sanitize_message(cls, v):
        # Remove caracteres perigosos
        dangerous_patterns = [
            r'<script[^>]*>.*?</script>',
            r'javascript:',
            r'on\w+\s*=',
        ]
        for pattern in dangerous_patterns:
            v = re.sub(pattern, '', v, flags=re.IGNORECASE)
        return v.strip()

class FileUploadValidator(BaseModel):
    filename: str = Field(..., max_length=255)
    content_type: str
    size_bytes: int = Field(..., le=10_000_000)  # 10MB limit
    
    @validator('filename')
    def validate_filename(cls, v):
        # Prevenir path traversal
        if '..' in v or '/' in v or '\\' in v:
            raise ValueError('Invalid filename')
        # Apenas extensões permitidas
        allowed_extensions = {'.pdf', '.txt', '.md', '.jpg', '.png'}
        if not any(v.lower().endswith(ext) for ext in allowed_extensions):
            raise ValueError(f'File type not allowed. Allowed: {allowed_extensions}')
        return v
```


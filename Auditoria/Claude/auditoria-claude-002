#### 1.3 Proteção Contra Prompt Injection
**Problema:** Sistema LLM vulnerável a prompt injection attacks.

**Impacto:** 🔴 ALTO - Bypass de segurança, acesso não autorizado  
**Prioridade:** P0

**Implementação:**
```python
# backend/app/features/security/prompt_guard.py
from typing import List
import re

class PromptInjectionGuard:
    """Protege contra ataques de prompt injection"""
    
    DANGEROUS_PATTERNS = [
        # Tentativas de override de sistema
        r'ignore\s+(previous|all|above)\s+instructions?',
        r'disregard\s+(previous|all|above)',
        r'forget\s+(previous|all|everything)',
        
        # Tentativas de exfiltração
        r'(show|display|print|output)\s+(system|hidden|secret)',
        r'repeat\s+(your|the)\s+(instructions|prompt)',
        
        # Tentativas de role-playing malicioso
        r'you\s+are\s+now\s+a\s+(hacker|attacker)',
        r'pretend\s+to\s+be',
        
        # Comandos do sistema
        r'\\x[0-9a-fA-F]{2}',  # Hex encoding
        r'base64\s*\(',
    ]
    
    def is_suspicious(self, text: str) -> tuple[bool, List[str]]:
        """Retorna (is_suspicious, matched_patterns)"""
        matched = []
        for pattern in self.DANGEROUS_PATTERNS:
            if re.search(pattern, text, re.IGNORECASE):
                matched.append(pattern)
        return (len(matched) > 0, matched)
    
    def sanitize(self, text: str) -> str:
        """Remove ou neutraliza padrões perigosos"""
        # Implementar lógica de sanitização
        sanitized = text
        for pattern in self.DANGEROUS_PATTERNS:
            sanitized = re.sub(pattern, '[FILTERED]', sanitized, flags=re.IGNORECASE)
        return sanitized

# Uso no agent
guard = PromptInjectionGuard()
is_suspicious, patterns = guard.is_suspicious(user_message)
if is_suspicious:
    logger.warning(f"Suspicious prompt detected: {patterns}")
    # Opção 1: Rejeitar
    # raise HTTPException(400, "Invalid input")
    # Opção 2: Sanitizar
    user_message = guard.sanitize(user_message)
```


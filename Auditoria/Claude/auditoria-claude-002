from typing import List, Dict
import httpx

class WebhookManager:
    async def trigger(self, event: str, data: Dict):
        """Dispara webhooks registrados para um evento"""
        webhooks = await self._get_webhooks_for_event(event)
        
        tasks = []
        for webhook in webhooks:
            task = self._send_webhook(webhook, data)
            tasks.append(task)
        
        await asyncio.gather(*tasks, return_exceptions=True)
    
    async def _send_webhook(self, webhook: Dict, data: Dict):
        async with httpx.AsyncClient() as client:
            try:
                response = await client.post(
                    webhook["url"],
                    json=data,
                    headers={"X-Webhook-Secret": webhook["secret"]},
                    timeout=10
                )
                response.raise_for_status()
            except Exception as e:
                logger.error(f"Webhook failed: {e}")
                # Enfileirar para retry
                await self._enqueue_retry(webhook, data)


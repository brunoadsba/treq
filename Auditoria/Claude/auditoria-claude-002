# backend/app/core/feature_flags.py
from typing import Optional
import redis

class FeatureFlags:
    def __init__(self, redis_client: redis.Redis):
        self.redis = redis_client
    
    def is_enabled(self, flag_name: str, user_id: Optional[str] = None) -> bool:
        # Global flag
        global_status = self.redis.get(f"flag:{flag_name}:global")
        if global_status == b"false":
            return False
        
        # User-specific override
        if user_id:
            user_status = self.redis.get(f"flag:{flag_name}:user:{user_id}")
            if user_status is not None:
                return user_status == b"true"
        
        # Percentage rollout
        rollout = self.redis.get(f"flag:{flag_name}:rollout")
        if rollout:
            import hashlib
            user_hash = int(hashlib.sha256((user_id or "").encode()).hexdigest(), 16)
            return (user_hash % 100) < int(rollout)
        
        return global_status == b"true"

# Uso
flags = FeatureFlags(redis_client)

if flags.is_enabled("new_llm_model", user_id):
    response = await new_llm_service.generate(prompt)
else:
